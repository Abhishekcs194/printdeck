<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      Declared by the module that uses them rather than only by the app, so the
      reason for each permission stays next to the code that needs it.

      INTERNET reaches printers and nothing else: PrivateAddressGuard rejects any
      address outside RFC 1918 / ULA / link-local before a socket is opened, so
      this cannot reach the public internet.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
</manifest>
